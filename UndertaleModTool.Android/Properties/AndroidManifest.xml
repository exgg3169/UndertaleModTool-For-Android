<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Optional: lets scripts read/write anywhere on shared storage (e.g. to import/export files).
         Opening and saving data files works without it, through the system file picker. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application android:allowBackup="true" android:supportsRtl="true" android:requestLegacyExternalStorage="true" />
</manifest>
